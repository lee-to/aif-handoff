{
  "name": "@aif/runtime",
  "version": "0.1.0",
  "description": "Runtime/provider abstraction and registry for AIF Handoff",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --configLoader runner",
    "coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "test:watch": "vitest --configLoader runner",
    "codex:app-server:protocol:generate": "node ./scripts/generate-codex-app-server-protocol.mjs",
    "codex:app-server:protocol:check": "node ./scripts/generate-codex-app-server-protocol.mjs --check"
  },
  "dependencies": {
    "@aif/shared": "*",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex-sdk": "0.145.0",
    "smol-toml": "^1.6.1",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}

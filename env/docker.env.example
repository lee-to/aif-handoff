# ============================================================
# Env для интерполяции ${...} в самом compose-файле (НЕ для app-сервисов).
# Compose читает корневой .env. SOPS-вольт env/docker.env расшифровывается на
# сервере в корневой .env через scripts/sops-decrypt.sh.
# ============================================================

# Тег образов в GHCR, который тянет compose (sha-xxx из CI).
IMAGE_TAG=latest

# HOME используется для bind ${HOME}/aif/{projects,data}. Сервер задаёт сам.
# Здесь дублировать НЕ нужно — берётся из окружения деплой-юзера.

# ------------------------------------------------------------
# Лимиты ресурсов для compose.production.yml (deploy.resources.limits).
# Задавать ТОЛЬКО если сервер отличается от дефолтного профиля 4 vCPU / 8G RAM.
#
# Дефолты в compose.production.yml: API 2 CPU/2G, AGENT 2 CPU/3G,
# MCP 0.5 CPU/512M, WEB 0.5 CPU/256M.
#
# ВНИМАНИЕ: cpus НЕ должен превышать число ядер сервера — docker daemon
# отклоняет создание контейнера ("range of CPUs is from 0.01 to N"), и деплой
# падает. memory overcommit допустим, но грозит OOM-kill.
#
# Пример для сервера 8 vCPU / 16G:
#   API_CPUS=3
#   API_MEMORY=4G
#   AGENT_CPUS=4
#   AGENT_MEMORY=8G
#   MCP_CPUS=1
#   MCP_MEMORY=1G
#   WEB_CPUS=0.5
#   WEB_MEMORY=512M
# ------------------------------------------------------------

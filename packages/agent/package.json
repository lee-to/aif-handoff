  },
  "dependencies": {
    "@aif/data": "*",
    "@aif/runtime": "*",
    "@aif/shared": "*",
    "@hono/node-server": "2.1.6",
    "hono": "^4.13.11",
    "ws": "^8.20.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}

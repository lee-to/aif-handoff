{
  "name": "@aif/agent",
  "version": "0.1.0",
  "description": "AI coordinator and subagents for AIF Handoff",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "dev:perf": "node --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.ts",
    "test": "vitest run --configLoader runner",

# ==========================================================
# AIF Handoff — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# Optional: create `.env.local` for machine-local overrides.
#
# - Docker compose users: `.env` is REQUIRED. docker-compose.yml
#   declares `env_file: .env`; without it compose prints a warning
#   and falls back to inline defaults.
# - Local dev users (`npm run dev`): scripts/dev.mjs reads the
#   copied `.env` file too. Most defaults are fine.
#
# Variables you most often want to set explicitly on first run:
#   ANTHROPIC_API_KEY — Claude API key (or use `claude login`
#                       inside the agent container, see README)
#   PROJECTS_DIR      — host directory for project files
#                       (default: ${PWD}/projects). Must exist
#                       on the host before `docker compose up`.
#   WEB_PORT          — host port for the React UI (default 5180)
#   PORT              — host port for the API      (default 3009)
#   MCP_PORT          — host port for the MCP HTTP server
#                       (default 3100, HTTP server is opt-in)
# ==========================================================

# ----------------------------------------------------------
# Ports
# ----------------------------------------------------------
PORT=3009
# WEB_PORT=5180
# WEB_HOST=localhost
#
# Change this if you're running handoff in DEV mode behind a reverse proxy.
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=handoff.example.com
DATABASE_URL=./data/aif.sqlite

# ----------------------------------------------------------
# Frontend Request Timeouts (compile-time constants)
# ----------------------------------------------------------
# These are NOT env vars — they are defined in packages/web/src/lib/api.ts.
# To change, edit the constants directly in the source file:
#   REQUEST_TIMEOUT_MS        = 15000    (CRUD requests)
#   PLAN_FAST_FIX_TIMEOUT_MS  = 200000   (AI plan fast fix)
#   CHAT_TIMEOUT_MS           = 300000   (chat with AI)
#   IMPORT_ROADMAP_TIMEOUT_MS = 300000   (roadmap import)

# ----------------------------------------------------------
# Docker
# ----------------------------------------------------------
# Host directory for project files (dev, bind mount)
# PROJECTS_DIR=./.projects
# Mount path for project files inside containers
# Paths outside this mount are resolved below it instead of the container root.
# PROJECTS_MOUNT=/home/www
# Compose-internal repository root used to resolve relative PROJECTS_DIR.
# docker-compose.yml sets this from ${PWD}; do not set it manually in .env.
# PROJECTS_HOST_ROOT=/absolute/path/to/aif-handoff
# Codex SDK and CLI npm selector resolved during Docker build.
# Supports dist-tags, exact versions, and semver ranges.
CODEX_VERSION=0.145.0

# ----------------------------------------------------------
# HTTP(S)/SOCKS proxy — used at build time (npm/apt/apk) and runtime
# ----------------------------------------------------------
# Leave unset if you don't need a proxy. When set, compose passes
# these to `docker build` as build-args AND injects them into
# running containers via `env_file: .env`.
# ALL_PROXY is used as the fallback for API transports and supports SOCKS5.
# NO_PROXY must include compose service names (api/agent/web/mcp)
# so internal calls do not go through the proxy.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# ALL_PROXY=socks5://proxy.example.com:1080
# NO_PROXY=localhost,127.0.0.1,::1,api,agent,web,mcp

# Production: domain for SSL certificate (Let's Encrypt via ACME)
# DOMAIN=example.com

# Production: host ports for Angie
# HTTP_PORT=80
# HTTPS_PORT=443

# CORS origin restriction (`*` allows all origins)
# CORS_ORIGIN=http://localhost:5180

# ----------------------------------------------------------
# Participants Mode (off by default)
# ----------------------------------------------------------
# Enables local participant accounts, role-based access, authenticated
# WebSockets, and Human/AI task ownership. Bootstrap the first admin before
# opening the UI; see docs/getting-started.md.
PARTICIPANTS_MODE_ENABLED=false
# Exact comma-separated browser origins. No paths, wildcards, or trailing `/`.
PARTICIPANT_ALLOWED_ORIGINS=http://localhost:5180
# Session lifetime in seconds (5 minutes to 365 days).
PARTICIPANT_SESSION_TTL_SECONDS=604800
PARTICIPANT_SESSION_COOKIE_NAME=aif_participant_session
# Set true for HTTPS outside production auto-detection.
PARTICIPANT_SESSION_COOKIE_SECURE=false
PARTICIPANT_LOGIN_RATE_LIMIT_WINDOW_MS=60000
PARTICIPANT_LOGIN_RATE_LIMIT_MAX=10

# ----------------------------------------------------------
# Agent Scheduler
# ----------------------------------------------------------
# How often coordinator polls for tasks (ms)
POLL_INTERVAL_MS=30000

# Per-stage hard timeout (planner/plan-checker/implementer/reviewer)
AGENT_STAGE_RUN_TIMEOUT_MS=3600000

# Stale task watchdog (ms + retries)
AGENT_STAGE_STALE_TIMEOUT_MS=5400000
AGENT_STAGE_STALE_MAX_RETRY=3

# Query startup guard:
# if no first stream message appears in timeout window,
# agent retries once after the delay below
AGENT_QUERY_START_TIMEOUT_MS=60000
AGENT_QUERY_START_RETRY_DELAY_MS=1000

# First-activity watchdog:
# if no tool call or subagent spawn appears after agent "started",
# abort the agent run after this timeout (detects hung agents early)
AGENT_FIRST_ACTIVITY_TIMEOUT_MS=60000

# API one-shot runtime call timeouts (roadmap/fast-fix/commit generation)
API_RUNTIME_START_TIMEOUT_MS=60000
API_RUNTIME_RUN_TIMEOUT_MS=120000

# Global safety ceiling for concurrent coordinator tasks across all projects (default: 12)
# COORDINATOR_MAX_CONCURRENT_TASKS=12
# Max concurrent tasks per stage for one parallel-enabled project (default: 3)
# Non-parallel projects always process 1 task at a time regardless of this value
# COORDINATOR_MAX_CONCURRENT_TASKS_PER_PROJECT=3
# Max independent project lanes the coordinator may process in one poll cycle (default: 4)
# COORDINATOR_MAX_CONCURRENT_PROJECTS=4

# Opt-in rollout for per-task git worktrees in branch-isolated parallel projects.
# Leave disabled unless operators have reviewed worktree retention and disk usage.
# AIF_TASK_WORKTREES_ENABLED=false

# Opt-in rollout for awaited auto-queue completion commits.
# When disabled, terminal transitions and coordinator concurrency keep legacy behavior.
# AIF_AGENT_AUTO_QUEUE_COMMIT_GATE_ENABLED=false

# Opt-in rollout for overlapping coordinator poll cycles.
# When disabled, the coordinator keeps its single-flight poll loop and the
# interval tick awaits each cycle. Enable to let triggers start a cycle for an
# idle project while a long stage is still draining.
# AIF_AGENT_OVERLAPPING_POLL_CYCLES_ENABLED=false

# Opt-in rollout for runtime session forks used by warmup flows.
# Leave disabled until warmup callers are enabled and monitored.
# AIF_RUNTIME_SESSION_FORK_ENABLED=false

# Opt-in rollout for stage-scoped runtime selection pins.
# When disabled, same-status retries resolve runtime profiles normally.
# AIF_STAGE_RUNTIME_PIN_ENABLED=false

# Opt-in rollout for provider-advertised model reasoning effort metadata.
# When disabled, profile controls and runtime execution use the stable per-runtime allowlists.
# AIF_RUNTIME_MODEL_EFFORT_DISCOVERY_ENABLED=false

# Opt-in rollout for the @hono/node-server v2 WebSocket request path.
# When disabled, the API keeps the legacy injected WebSocket bridge.
# AIF_API_NODE_SERVER_V2_WEBSOCKET_ENABLED=false

# Opt-in OpenCode API transport workaround for long model generations.
# When enabled, /session/:id/message uses an undici dispatcher with disabled
# header/body idle timeouts while AGENT_STAGE_RUN_TIMEOUT_MS remains authoritative.
# AIF_RUNTIME_OPENCODE_LONG_RUNNING_DISPATCHER_ENABLED=false

# ----------------------------------------------------------
# Agent Permissions
# ----------------------------------------------------------
# Bypass runtime permission checks for subagents (npm install, git, etc.)
# When false, configure allowed commands via .claude/settings.json (Claude adapter)
AGENT_BYPASS_PERMISSIONS=true

# Default for the per-task "Use subagents" setting (overridable in task Planner settings):
# false (default) — run via skills (aif-plan/aif-implement/aif-review/aif-security-checklist)
# true — run via custom subagents (plan-coordinator/implement-coordinator/review-sidecar/security-sidecar)
# AGENT_USE_SUBAGENTS=false

# Max turns (tool calls) for chat sessions before runtime terminates (default: 50):
# AGENT_CHAT_MAX_TURNS=50

# Max review→implement iterations in auto mode before moving task to Done (default: 3):
# AGENT_MAX_REVIEW_ITERATIONS=3

# ----------------------------------------------------------
# Runtime Provider Credentials
# ----------------------------------------------------------
# Claude adapter (SDK transport) — uses ~/.claude/ auth by default
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_AUTH_TOKEN=token-xxxxx        # alternative bearer-style credential for proxies
# ANTHROPIC_MODEL=claude-sonnet-4-5       # default model when profile.defaultModel is not set
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # custom Anthropic-compatible endpoint

# Codex adapter — API transport (remote OpenAI-compatible execution).
# OPENAI_API_KEY / OPENAI_BASE_URL apply to the API transport only.
# OPENAI_API_KEY=sk-openai-xxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4

# Codex local transports (SDK/CLI/App Server) default to `codex login` / OAuth and
# do NOT consume the ambient OPENAI_API_KEY/OPENAI_BASE_URL above — that way a
# placeholder key cannot hijack an OAuth-backed session. To run a local transport
# with API-key auth, set the runtime profile's apiKeyEnvVar (e.g. OPENAI_API_KEY)
# or apiKey explicitly. For a custom local endpoint, set the profile baseUrl or
# CODEX_BASE_URL below (OPENAI_BASE_URL is ignored for local transports).
# CODEX_BASE_URL=https://your-codex-endpoint/api

# Codex CLI/SDK/App Server transports — path to codex binary
# Runtime profile options.codexCliPath overrides CODEX_CLI_PATH when configured.
# CODEX_CLI_PATH=/absolute/path/to/codex

# Opt-in rollout for Codex SDK native subagents.
# Leave disabled to keep the isolated skill-session fallback as the default.
# AIF_RUNTIME_CODEX_NATIVE_SUBAGENTS_ENABLED=false

# OpenRouter adapter (API transport) — unified API proxy for 200+ models
# OPENROUTER_API_KEY=sk-or-xxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_HTTP_REFERER=https://your-app.com
# OPENROUTER_APP_TITLE=AIF Handoff

# Default runtime/provider when no profile is configured (overrides built-in "claude"/"anthropic")
# AIF_DEFAULT_RUNTIME_ID=claude
# AIF_DEFAULT_PROVIDER_ID=anthropic

# Optional — comma-separated runtime module specifiers loaded at startup
# AIF_RUNTIME_MODULES=@org/runtime-module,file:///absolute/path/runtime-module.mjs

# API base URL used by agent for best-effort notifications
# API_BASE_URL=http://localhost:3009
# Internal token required to authorize task/project broadcast calls outside tests.
# The agent notifier sends it via Authorization + X-Internal-Broadcast-Token.
# INTERNAL_BROADCAST_TOKEN=change-me

# GitHub Issue-to-PR mode is off by default.
# AIF_GITHUB_ISSUE_PR_ENABLED=false
# The project connection stores this variable name,
# never the token value. Fine-grained tokens need repository metadata read,
# issues read/write, pull requests read/write, contents read/write, commit
# statuses read, and checks read.
# GITHUB_TOKEN=github_pat_xxxxx

# ----------------------------------------------------------
# MCP Server
# ----------------------------------------------------------
# Transport mode: "stdio" (default, for local Claude Code) or "http" (for Docker)
# MCP_TRANSPORT=stdio
# HTTP port when MCP_TRANSPORT=http (default: 3100)
# MCP_PORT=3100
# Multi-session HTTP transport (opt-in, default off). When unset/false the HTTP
# transport keeps the legacy single-session behavior (only one client can
# initialize). Set to true/1/yes/on to let multiple clients — e.g. several
# Claude Code windows — connect concurrently to the same /mcp endpoint.
# Only used when MCP_TRANSPORT=http.
# AIF_MCP_HTTP_MULTI_SESSION_ENABLED=false
# Required bearer token whenever MCP_TRANSPORT=http.
# Keep it separate from browser session cookies and CSRF tokens.
# MCP_AUTH_TOKEN=replace-with-a-long-random-token
# Rate limits
# MCP_RATE_LIMIT_READ_RPM=120
# MCP_RATE_LIMIT_WRITE_RPM=30

# ----------------------------------------------------------
# Observability
# ----------------------------------------------------------
AGENT_QUERY_AUDIT_ENABLED=false
LOG_LEVEL=debug

# Activity logging strategy: "sync" (per-event write) or "batch" (buffered flush)
# ACTIVITY_LOG_MODE=sync
# Max entries per flush (batch mode only)
# ACTIVITY_LOG_BATCH_SIZE=20
# Max age (ms) before auto-flush (batch mode only)
# ACTIVITY_LOG_BATCH_MAX_AGE_MS=5000
# Hard queue limit to prevent unbounded memory growth (batch mode only)
# ACTIVITY_LOG_QUEUE_LIMIT=500

# Enable event-driven wake channel (WebSocket subscription to API)
# Set to false to use polling-only mode
# AGENT_WAKE_ENABLED=true

# ----------------------------------------------------------
# Usage-limits feature toggle (master switch)
# ----------------------------------------------------------
# Default false. When false the full usage-limits pipeline is off:
#   * /runtime-profiles skips the ~/.codex/sessions filesystem scan and the
#     Claude provider-identity lookup.
#   * Runtime service skips observeRuntimeLimitEvent /
#     extractLatestRuntimeLimitSnapshot / extractRuntimeLimitSnapshotFromError
#     during every runtime run, and suppresses the
#     project:runtime_limit_updated WebSocket broadcast.
#   * Agent stage error handler does not persist limitSnapshot onto tasks.
#   * Chat API omits runtimeLimitSnapshot from responses.
#   * Web UI hides the USAGE button, TaskCard/TaskDetailHeader badges,
#     Recent Limit Signals panel, and Chat active-limit banner.
# Persisted snapshots are still returned on read but never refreshed.
# Enable only if you actively monitor rate-limit windows.
# AIF_USAGE_LIMITS_ENABLED=false

# ----------------------------------------------------------
# Runtime warmup feature toggle (master switch)
# ----------------------------------------------------------
# Default false. When false the warmup API reports disabled, create requests
# return 403, and the web UI hides Warmup entry points.
# Enable only for runtimes/transports that advertise session fork support.
# AIF_WARMUP_ENABLED=false

# ----------------------------------------------------------
# QA pipeline feature toggle (master switch)
# ----------------------------------------------------------
# Default false. When false the manual POST /tasks/:id/run-qa endpoint returns
# 403 and the autoQa auto-trigger on approve_done is skipped. Enable to run the
# /aif-qa --all pipeline (change-summary -> test-plan -> test-cases) for tasks.
# AIF_QA_PIPELINE_ENABLED=false

# ----------------------------------------------------------
# Codex OAuth login in Docker (dev-only broker)
# ----------------------------------------------------------
# Wraps `codex login --device-auth` so the host browser can complete the
# device-code flow against an agent container. Keep disabled in production —
# rely on OPENAI_API_KEY instead.
# AIF_ENABLE_CODEX_LOGIN_PROXY=false
# AIF_CODEX_LOGIN_BROKER_PORT=3010
# AGENT_INTERNAL_URL=http://agent:3010

# ----------------------------------------------------------
# Telegram Notifications (optional)
# ----------------------------------------------------------
# Best-effort messages on task status changes. If not set, disabled silently.
# Opt in to adding the task's project name; disabled keeps the legacy two-line format.
# AIF_NOTIFICATIONS_PROJECT_NAMES_ENABLED=false
# TELEGRAM_BOT_API_URL=https://api.telegram.org
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_USER_ID=987654321
